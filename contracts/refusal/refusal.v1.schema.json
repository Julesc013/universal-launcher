{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-launcher/contracts/refusal/refusal.v1.schema.json",
  "title": "Universal Launcher Refusal",
  "type": "object",
  "required": ["schema", "status", "error"],
  "properties": {
    "schema": { "const": "ulk.command_response.v1" },
    "status": { "enum": ["refused", "unsupported", "invalid_argument"] },
    "payload": { "type": ["object", "null"] },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
