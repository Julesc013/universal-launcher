{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-launcher/contracts/schema/composition/product_composition.v1.schema.json",
  "title": "Universal Launcher Product Composition",
  "type": "object",
  "required": ["schema", "product", "entrypoints", "contract_set"],
  "properties": {
    "schema": { "const": "ulk.product_composition.v1" },
    "product": { "$ref": "product_descriptor.v2.schema.json" },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "entrypoint_descriptor.v1.schema.json" }
    },
    "contract_set": { "$ref": "contract_set_identity.v1.schema.json" }
  },
  "additionalProperties": false
}
