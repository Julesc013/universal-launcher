{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/ulk/setup/installed_state_reference.v1.schema.json",
  "title": "Installed State Reference",
  "type": "object",
  "required": [
    "schema",
    "setup_state_ref",
    "install_id",
    "product_id",
    "exact_product_version",
    "entrypoint",
    "capabilities",
    "lifecycle_status",
    "last_verification_identity",
    "state_revision"
  ],
  "properties": {
    "schema": { "const": "ulk.installed_state_reference.v1" },
    "setup_state_ref": { "type": "string", "minLength": 1 },
    "install_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "exact_product_version": { "type": "string", "minLength": 1 },
    "entrypoint": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "enum": ["active", "verification_failed", "recovery_required", "retired", "uninstalled"]
    },
    "last_verification_identity": { "type": "string", "minLength": 1 },
    "state_revision": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
