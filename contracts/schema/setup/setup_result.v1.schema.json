{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/ulk/setup/setup_result.v1.schema.json",
  "title": "Setup Result",
  "type": "object",
  "required": [
    "schema",
    "result_id",
    "plan_id",
    "plan_digest",
    "operation",
    "product_id",
    "setup_provider",
    "provider_revision",
    "status"
  ],
  "properties": {
    "schema": { "const": "ulk.setup_result.v1" },
    "result_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_digest": { "type": "string", "minLength": 1 },
    "operation": {
      "enum": ["install", "verify", "repair", "move", "uninstall", "recovery"]
    },
    "product_id": { "type": "string", "minLength": 1 },
    "setup_provider": { "type": "string", "minLength": 1 },
    "provider_revision": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "refused", "failed", "recovery_required"] },
    "installed_state": {
      "oneOf": [
        { "$ref": "installed_state_reference.v1.schema.json" },
        { "type": "null" }
      ]
    },
    "audit_identity": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "completed" },
          "operation": { "enum": ["install", "verify", "repair", "move", "recovery"] }
        },
        "required": ["status", "operation"]
      },
      "then": { "required": ["installed_state", "audit_identity"] }
    }
  ],
  "additionalProperties": false
}
