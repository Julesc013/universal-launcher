{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flaunch.dev/contracts/launcher/client_transport.v1.schema.json",
  "title": "Universal Launcher client transport descriptor",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "revision"
  ],
  "properties": {
    "schema": {
      "const": "ulk.client_transport.v1"
    },
    "kind": {
      "enum": [
        "direct",
        "process",
        "daemon"
      ]
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
