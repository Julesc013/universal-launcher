{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-launcher/schema/artifact_set/artifact_set.v1.schema.json",
  "title": "Universal Launcher Artifact Set",
  "type": "object",
  "required": ["schema_version", "product_id", "artifact_set_id", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "artifact_set_id": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "lock": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
